# Copy this file to .env and fill in your own values. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ribra?retryWrites=true&w=majority

# Where the frontend runs (used for CORS). Comma-separate several origins.
CLIENT_URL=http://localhost:5173

# Secret that signs login tokens. Optional locally; REQUIRED in production.
# Generate one with:  openssl rand -base64 48
JWT_ACCESS_SECRET=

# AI provider (any OpenAI-compatible API). Free Gemini key: https://aistudio.google.com/apikey
AI_API_KEY=
# Optional overrides (defaults shown):
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-flash-latest
# FREE_CV_ANALYSES_PER_MONTH=5
# FREE_JOB_MATCHES_PER_MONTH=5
# FREE_COVER_LETTERS_PER_MONTH=5
# FREE_INTERVIEW_PREPS_PER_MONTH=5
# FREE_ANSWER_FEEDBACK_PER_MONTH=30

# Emails (confirm email, reset password) via Brevo's HTTP API: https://app.brevo.com
# Without these, emails are printed in this terminal instead, which is fine for local development.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=Ribra

# "Continue with Google": OAuth client ID from Google Cloud (same value as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Public website address used in email links (defaults to the first CLIENT_URL)
# APP_URL=https://ribra.vercel.app

# Payments with Paystack: https://dashboard.paystack.com/#/settings/developers
# Use the TEST secret key (sk_test_...) until you are ready to take real money.
PAYSTACK_SECRET_KEY=
# Create the monthly plan with: npm run paystack:plan -w server
PAYSTACK_PLAN_CODE=
# PRO_PRICE_NGN=5000

# Daily reminder emails (tracker next steps due today/tomorrow).
# A scheduled GitHub Action calls the API with this secret. Generate one with: openssl rand -hex 32
CRON_SECRET=
# REMINDER_TIMEZONE=Africa/Lagos
