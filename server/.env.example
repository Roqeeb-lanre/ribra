# Copy this file to .env and fill in your own values. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ribra?retryWrites=true&w=majority

# Where the frontend runs (used for CORS). Comma-separate several origins.
CLIENT_URL=http://localhost:5173
