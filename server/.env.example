# Copy this file to .env and fill in your own values. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ribra?retryWrites=true&w=majority

# Where the frontend runs (used for CORS). Comma-separate several origins.
CLIENT_URL=http://localhost:5173

# Secret that signs login tokens. Optional locally; REQUIRED in production.
# Generate one with:  openssl rand -base64 48
JWT_ACCESS_SECRET=

# AI provider (any OpenAI-compatible API). Free Gemini key: https://aistudio.google.com/apikey
AI_API_KEY=
# Optional overrides (defaults shown):
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-flash-latest
# FREE_CV_ANALYSES_PER_MONTH=5
