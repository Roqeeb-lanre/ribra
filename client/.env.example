# OAuth client ID for "Continue with Google" (Google Cloud > APIs & Services > Credentials).
# Leave empty to hide the Google button. Set the same value on Vercel.
VITE_GOOGLE_CLIENT_ID=

# API calls go to /api on the same domain:
#  - locally, vite.config.ts forwards /api to http://localhost:4000
#  - on Vercel, vercel.json forwards /api to https://ribra-api.onrender.com
